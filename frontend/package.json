{
  "name": "autocare-hub-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "backend:db": "docker compose --env-file ../deploy/docker/.env -f ../deploy/docker/docker-compose.yml up -d postgres",
    "backend:api": "cd ../backend && mvn spring-boot:run",
    "backend:test": "cd ../backend && mvn test",
    "backend:security": "cd ../backend && mvn dependency-check:check"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.1",
    "vite": "^8.0.16",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^9.33.0"
  }
}
