{
  "name": "AutoCare Hub",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/SOAT-FIAP",
  "forwardPorts": [8080, 5173, 5432],
  "portsAttributes": {
    "8080": {
      "label": "Backend API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Frontend",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest"
    }
  },
  "containerEnv": {
    "DB_URL": "jdbc:postgresql://postgres:5432/autocarehub",
    "DB_USERNAME": "autocarehub",
    "DB_PASSWORD": "autocarehub-local-password",
    "JWT_SECRET": "codespaces-local-jwt-secret-at-least-32-bytes",
    "JWT_EXPIRATION_MINUTES": "60",
    "SERVER_PORT": "8080",
    "SPRING_PROFILES_ACTIVE": "local",
    "APP_CORS_ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173"
  },
  "postCreateCommand": "mvn -q -DskipTests dependency:go-offline && cd frontend && npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack",
        "hashicorp.terraform",
        "Vue.volar"
      ]
    }
  }
}
