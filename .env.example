POSTGRES_DB=autocarehub
POSTGRES_USER=autocarehub
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_PORT=5432

APP_PORT=8080
FRONTEND_PORT=5173
JWT_SECRET=replace-with-local-jwt-secret-at-least-32-bytes
JWT_EXPIRATION_MINUTES=60
SPRING_PROFILES_ACTIVE=local
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
JAVA_OPTS=-Xms256m -Xmx512m

# Optional variables for running the API directly with Maven instead of Docker.
# Docker Compose sets DB_URL, DB_USERNAME and DB_PASSWORD for the app container.
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/autocarehub
DB_USERNAME=autocarehub
DB_PASSWORD=replace-with-local-postgres-password
